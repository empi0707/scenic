# TMDB (required)
REACT_APP_API_KEY=        # client, in development
TMDB_API_KEY=             # edge functions (detail render, sitemap, proxy)

# Streaming servers (movie and TV pairs, up to 14)
REACT_APP_MOVIE_SERVER1=
REACT_APP_TV_SERVER1=
# REACT_APP_MOVIE_SERVER2=
# REACT_APP_TV_SERVER2=
# ...repeat through REACT_APP_MOVIE_SERVER14 / REACT_APP_TV_SERVER14

# Downloads (optional)
DOWNLOAD_BASE_URL=

# Ad-free player (Scenic+) — server-side extractor (api/_streamSource)
# Catalog host base URL; resolves a TMDB id to an HLS stream via slug + player ajax.
CATALOG_BASE=

# Set true to show Scenic+ in the player
REACT_APP_ADFREE_ENABLED=false
