# TMDB (required)
REACT_APP_API_KEY=        # client, in development
TMDB_API_KEY=             # edge functions (detail render, sitemap, proxy)

# Streaming servers (movie and TV pairs, up to 14). Slots 4, 10, 11 in
# src/utils/serverUrl.js append a fixed suffix after the id; slot 12's TV side uses a
# query-style "video_id=..&tmdb=1&s=..&e=.." format instead of a path; slot 8 ignores
# its base URL and rotates through REACT_APP_SERVER8_DOMAINS instead.
REACT_APP_MOVIE_SERVER1=https://vidsrcme.su/embed/movie/
REACT_APP_TV_SERVER1=https://vidsrcme.su/embed/tv/

REACT_APP_MOVIE_SERVER2=https://cinemaos.tech/player/
REACT_APP_TV_SERVER2=https://cinemaos.tech/player/

REACT_APP_MOVIE_SERVER3=https://vidsrc-embed.ru/embed/movie/
REACT_APP_TV_SERVER3=https://vidsrc-embed.ru/embed/tv/

# Suffix "?autoplay=true&colour=6366f1" is appended after the id.
REACT_APP_MOVIE_SERVER4=https://player.videasy.net/movie/
REACT_APP_TV_SERVER4=https://player.videasy.net/tv/

REACT_APP_MOVIE_SERVER5=https://vidsrc-embed.su/embed/movie/
REACT_APP_TV_SERVER5=https://vidsrc-embed.su/embed/tv/

REACT_APP_MOVIE_SERVER6=https://vsrc.su/embed/movie/
REACT_APP_TV_SERVER6=https://vsrc.su/embed/tv/

REACT_APP_MOVIE_SERVER7=https://vidlink.pro/movie/
REACT_APP_TV_SERVER7=https://vidlink.pro/tv/

# Slot 8 ignores REACT_APP_MOVIE_SERVER8 / REACT_APP_TV_SERVER8 and instead rotates
# through this comma-separated domain list, reusing the vidsrc-embed mirrors above.
REACT_APP_SERVER8_DOMAINS=vidsrc-embed.ru,vidsrc-embed.su

REACT_APP_MOVIE_SERVER9=https://player.autoembed.app/embed/movie/
REACT_APP_TV_SERVER9=https://player.autoembed.app/embed/tv/

# Suffix "?autoplay=true" is appended after the id.
REACT_APP_MOVIE_SERVER10=https://player.smashystream.com/movie/
REACT_APP_TV_SERVER10=https://player.smashystream.com/tv/

# Suffix "?theme=6366f1&startAt=15" is appended after the id.
REACT_APP_MOVIE_SERVER11=https://vidfast.pro/movie/
REACT_APP_TV_SERVER11=https://vidfast.pro/tv/

# TV side uses the "video_id=..&tmdb=1&s=..&e=.." format (see note above), matching
# MultiEmbed's TV endpoint exactly; MultiEmbed's movie endpoint doesn't fit this slot's
# plain format so the movie side uses 111Movies instead.
REACT_APP_MOVIE_SERVER12=https://111movies.com/movie/
REACT_APP_TV_SERVER12=https://multiembed.mov/?video_id=

REACT_APP_MOVIE_SERVER13=https://vidora.su/movie/
REACT_APP_TV_SERVER13=https://vidora.su/tv/

REACT_APP_MOVIE_SERVER14=https://www.vidking.net/embed/movie/
REACT_APP_TV_SERVER14=https://www.vidking.net/embed/tv/

# Downloads (optional)
DOWNLOAD_BASE_URL=

# Ad-free player (FreeMovies+) — server-side extractor (api/_streamSource)
# Catalog host base URL; resolves a TMDB id to an HLS stream via slug + player ajax.
CATALOG_BASE=
# The catalog's admin-ajax "action" name used to resolve a player embed.
CATALOG_PLAYER_ACTION=

# Secondary ad-free source (api/_mirrorSource) — id-native embed host, tried as a
# fallback when the primary source fails to resolve or play.
MIRROR_BASE=

# Tertiary ad-free source (api/_relaySource) — id-native aggregator whose stream
# payload is decoded server-side. Base host, comma-separated provider routes
# (tried in order; coverage varies per title), the stream referer, and an
# optional id-native subtitle host are all env-driven. Providers may serve HLS
# or a direct MP4.
RELAY_BASE=
RELAY_PROVIDER=
RELAY_REFERER=
RELAY_SUB_BASE=

# HLS proxy origin. Unset = the in-repo Vercel function (api/hls-proxy.js),
# which bills every segment byte as Fast Origin Transfer — Hobby caps at 10 GB
# a month, roughly four hours of 1080p. Point this at the Cloudflare Worker in
# worker/ to move that traffic somewhere egress isn't billed. No trailing slash.
#   PROXY_BASE=https://stream.scenicplus.workers.dev
PROXY_BASE=

# Subtitle fallback (OpenSubtitles) — used when the source ships no subtitle
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_UA=FreeMovies v1.0

# Set true to show FreeMovies+ in the player
REACT_APP_ADFREE_ENABLED=false

# Ads are NOT env vars — each concern has exactly one plain file to edit
# directly (no .env, no restart, edits apply on save):
#   - src/ads.html          fixed, always-on-screen banners on every page
#                            (top/bottom/left/right/center); mounted by
#                            src/components/global-ads/GlobalAds.jsx.
#   - src/config/adsConfig.js  the two in-page slots (detail page, watch
#                            page), mounted via src/components/ad-slot/
#                            AdSlot.jsx. Empty key = that slot renders nothing.

# White-label branding for iframe embeds (src/config/embedBranding.js). A
# parent page adds ?brand=&logo=&color=RRGGBB once to the FreeMovies URL it
# embeds; FreeMovies remembers those values (sessionStorage) for the rest of
# that visit, so they aren't lost when the visitor clicks to another FreeMovies
# page inside the same iframe. No effect outside an iframe — nothing to set
# here, this is a runtime (query-string) feature, not an env var.
