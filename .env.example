# TMDB (required)
REACT_APP_API_KEY=        # client, in development
TMDB_API_KEY=             # edge functions (detail render, sitemap, proxy)

# Streaming servers (movie and TV pairs, up to 14)
REACT_APP_MOVIE_SERVER1=
REACT_APP_TV_SERVER1=
# REACT_APP_MOVIE_SERVER2=
# REACT_APP_TV_SERVER2=
# ...repeat through REACT_APP_MOVIE_SERVER14 / REACT_APP_TV_SERVER14

# Downloads (optional)
DOWNLOAD_BASE_URL=

# Ad-free player source (server-side; host for the /api/stream extractor)
STREAM_BASE_URL=

# Optional: scraper/unlocker prefix so the scrape runs from a residential IP
# (the source 403s Vercel's datacenter IP). Must end in `url=`, e.g.:
# SCRAPE_PROXY=https://api.scraperapi.com/?api_key=YOUR_KEY&url=
SCRAPE_PROXY=
